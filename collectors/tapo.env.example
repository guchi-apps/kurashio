# collectors/tapo_to_myroom.py 用の設定。
# **この内容を collectors/.env に追記して実値を入れる**（.env はgitignore済み・
# 収集スクリプト共通で1ファイル）。実値は 1Password の apps/MyRoom から取る。

# TP-Link アカウント（Tapo アプリでプラグを登録したときのもの）
TAPO_USERNAME=your@email.com
TAPO_PASSWORD=your_password

# 対象のプラグ（**任意**）。収集のたびに LAN 上の Tapo 機器を自動で探すので、Tapo アプリで
# プラグを足しただけで反映される（すぐ反映したいときは --rediscover）。
# ここに書くのは「表示名を固定したい」「探索で見つからない」機器だけでよい。
# `IP=表示名` をカンマ区切りで並べる。`=表示名` を省くとプラグ自身の名前（alias）を使う。
# 同じ IP は、ここに書いたほうを優先する。IP は --list-devices で調べられる。
#
# **表示名はあとから変えないこと。** そのまま daily_energy.source（tapo:<表示名>）に
# なるため、変えると別の機器として記録され、グラフが途中で途切れる。
TAPO_HOSTS=192.168.2.21=冷蔵庫,192.168.2.22=テレビ

# MyRoom の受け口。ローカル検証時は http://localhost:8000/api/energy に向ける
MYROOM_ENERGY_API_URL=https://myroom.gucchii.com/api/energy
