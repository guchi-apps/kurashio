# collectors/aircon_energy_to_myroom.py 用の設定。
# このファイルを collectors/.env にコピーして実値を入れる（.env はgitignore済み）。
# 実値は 1Password の apps/MyRoom から取る。

# 白くまくんアプリ（AirCloud Home）のログイン情報
AIRCON_EMAIL=your@email.com
AIRCON_PASSWORD=your_password

# 複数台ある場合だけ、対象を racName か vendorThingId で指定する（省略時は全台合計）
# AIRCON_UNIT_NAME=リビング

# MyRoom の受け口。ローカル検証時は http://localhost:8000/api/energy に向ける
MYROOM_ENERGY_API_URL=https://myroom.gucchii.com/api/energy

# 「指定日以降の再取得」（#711）の依頼取得・完了報告に使う収集専用トークン（#714）。
# VPS の COLLECTOR_API_KEY と同じ値。未設定なら再取得だけを見送り、通常の収集は続く。
# 値の取り方は README の「収集専用トークン」。実値はこのファイルへ書かず .env にだけ置く
COLLECTOR_API_KEY=

# 当日から遡って送り直す日数（当日ぶんは1日のあいだ増えるため、既定で前日ぶんも送る）
ENERGY_DAYS=2

HTTP_TIMEOUT=30
